{
  "name": "senac-manager",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.cjs",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "test": "jest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "admin:create": "node dist/scripts/create-admin.js",
    "test:browser": "npm run build && node scripts/browser-test.cjs",
    "db:init": "node scripts/database.cjs init",
    "db:seed": "node scripts/database.cjs seed",
    "db:reset": "node scripts/database.cjs reset"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.13",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
