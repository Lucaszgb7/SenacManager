# =============================================================================
# SENACMANAGER — MODELO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# =============================================================================
# Copie este arquivo para .env e ajuste conforme o ambiente de execução:
#   cp .env.example .env
#
# AVISO: Nunca comite credenciais ou segredos reais no controle de versão.
# =============================================================================

# Porta do servidor HTTP (padrão: 3000)
PORT=3000

# Ambiente da aplicação: 'development' | 'production' | 'test'
NODE_ENV=development

# -----------------------------------------------------------------------------
# 1. DRIVER DE BANCO DE DADOS (DB_DRIVER)
# -----------------------------------------------------------------------------
# - 'json'  : Persistência em arquivos JSON locais em src/data/ (ou DATA_DIR).
#             Ideal para desenvolvimento local sem necessidade de instalar MySQL.
# - 'mysql' : Banco de dados relacional MySQL 8.
#             Obrigatório em produção. Requer servidor MySQL ativo.
DB_DRIVER=json

# Configuração de conexão com o MySQL (obrigatório somente se DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=senacmanager
DB_USER=root
DB_PASSWORD=sua_senha_segura_aqui

# -----------------------------------------------------------------------------
# 2. SESSÕES E COOKIES (SESSION_SECRET & TRUST_PROXY)
# -----------------------------------------------------------------------------
# Chave secreta para assinatura dos cookies de sessão (express-session).
# - Desenvolvimento: utiliza valor padrão se não informado.
# - Produção: OBRIGATÓRIA chave aleatória forte com pelo menos 16 caracteres.
SESSION_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria-em-producao

# Configuração de Proxy de Confiança (Express 'trust proxy'):
# - '0' ou 'false' : Desativa confiança em cabeçalhos de proxy.
#                    Use quando a aplicação roda diretamente sem proxies reversos.
# - '1' ou 'true'  : Confia no primeiro proxy reverso (padrão).
#                    Necessário em GitHub Codespaces, Google Cloud Run, Heroku e Nginx.
#                    Permite que o Express identifique corretamente requisições HTTPS
#                    e defina cookies seguros com SameSite=None em iframes/port-forwarding.
TRUST_PROXY=1

# -----------------------------------------------------------------------------
# 3. DEMONSTRAÇÃO E TESTES (HACKATHON)
# -----------------------------------------------------------------------------
# Controla a exibição do painel de contas rápidas na tela de login.
# - 'true'  : Exibe os botões de preenchimento rápido (Admin, Professor, Aluno).
#             Funciona apenas quando NODE_ENV !== 'production'.
# - 'false' : Oculta completamente as credenciais de demonstração.
# NOTA: Em produção (NODE_ENV=production), as contas demo são SEMPRE ocultadas.
SHOW_DEMO_ACCOUNTS=true

# -----------------------------------------------------------------------------
# 4. DIRETÓRIOS CUSTOMIZADOS (OPCIONAL)
# -----------------------------------------------------------------------------
# DATA_DIR=./src/data
# AVATAR_DIR=./public/uploads/avatars