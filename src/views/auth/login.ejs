<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../partials/head', { title: 'Entrar', pageCss: 'login.css' }) %>

<body class="login-page">
  <main class="login-container">
    <section class="card login-card">

      <!-- Cabeçalho / Identidade -->
      <header class="login-brand">
        <h1 class="login-brand__name">SenacManager</h1>
        <p class="login-brand__tagline">
          Organize aulas, salas e horários em um só lugar
        </p>
      </header>

      <!-- Bloco de erro vindo do backend -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="login-alert" role="alert">
          <%= error %>
        </div>
      <% } %>

      <!-- Formulário de login -->
      <form
        id="login-form"
        class="login-form"
        method="POST"
        action="/auth/login"
        novalidate
      >
        <!-- Campo: e-mail -->
        <div class="input-group">
          <label for="email">E-mail</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="seu.email@senac.com"
            autocomplete="email"
            required
          />
          <span class="error-message" data-error-for="email"></span>
        </div>

        <!-- Campo: senha (com toggle de visibilidade) -->
        <div class="input-group">
          <label for="password">Senha</label>
          <div class="password-wrapper">
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Digite sua senha"
              autocomplete="current-password"
              required
            />
            <button
              type="button"
              class="password-toggle"
              id="toggle-password"
              aria-label="Mostrar senha"
              aria-pressed="false"
            >
              <!-- Ícone: olho aberto (SVG inline) -->
              <svg
                id="icon-eye"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>

              <!-- Ícone: olho fechado (SVG inline) -->
              <svg
                id="icon-eye-off"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                style="display: none"
              >
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
            </button>
          </div>
          <span class="error-message" data-error-for="password"></span>
        </div>

        <!-- Linha: lembrar-me + esqueci minha senha -->
        <div class="login-form__row">
          <label class="checkbox-group" for="remember">
            <input type="checkbox" id="remember" name="remember" value="1" />
            Lembrar-me
          </label>

          <a href="/auth/forgot-password" class="link">Esqueci minha senha</a>
        </div>

        <!-- Botão de envio -->
        <button
          type="submit"
          id="submit-btn"
          class="btn btn-primary login-form__submit"
        >
          Entrar
        </button>
      </form>

      <!-- Rodapé do card -->
      <footer class="login-footer">
        <p>
          Ainda não tem conta?
          <a href="/contato" class="link">Fale com a administração</a>
        </p>
      </footer>

    </section>
  </main>

  <script src="/js/login.js" defer></script>
</body>
</html>