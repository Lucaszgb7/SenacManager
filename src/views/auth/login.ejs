
<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../partials/head', { title: 'Entrar', pageCss: 'login.css' }) %>

<body class="login-page">
  <main class="login-container">
    <section class="card login-card">

      <!-- Cabeçalho do SenacManager -->
      <header class="login-brand">
        <h1 class="login-brand__name">SenacManager</h1>
        <p class="login-brand__tagline">
          Organize aulas, salas e horários em um só lugar
        </p>
      </header>

      <!-- Mensagem de erro enviada pelo servidor -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="login-alert" role="alert">
          <%= error %>
        </div>
      <% } %>

      <!-- Formulário de autenticação -->
      <form
        id="login-form"
        class="login-form"
        method="POST"
        action="/auth/login"
        novalidate
      >
        <!-- Campo de e-mail -->
        <div class="input-group">
          <label for="email">E-mail</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="seu.email@senac.com"
            autocomplete="email"
            required
          />
          <span class="error-message" data-error-for="email"></span>
        </div>

        <!-- Campo de senha e botão de visibilidade -->
        <div class="input-group">
          <label for="password">Senha</label>

          <div class="password-wrapper">
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Digite sua senha"
              autocomplete="current-password"
              required
            />

            <button
              type="button"
              class="password-toggle"
              id="toggle-password"
              aria-label="Mostrar senha"
              aria-pressed="false"
            >
              <!-- Ícone de senha visível -->
              <svg
                id="icon-eye"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>

              <!-- Ícone de senha oculta -->
              <svg
                id="icon-eye-off"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                style="display: none"
              >
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
            </button>
          </div>

          <span class="error-message" data-error-for="password"></span>
        </div>

        <!-- Opções adicionais do login -->
        <div class="login-form__row">
          <label class="checkbox-group" for="remember">
            <input
              type="checkbox"
              id="remember"
              name="remember"
              value="1"
            />
            Lembrar-me
          </label>

          <a href="/auth/forgot-password" class="link">
            Esqueci minha senha
          </a>
        </div>

        <!-- Botão de autenticação -->
        <button
          type="submit"
          id="submit-btn"
          class="btn btn-primary login-form__submit"
        >
          Entrar
        </button>
      </form>

      <!-- Contas de demonstração -->
      <div class="demo-accounts">
        <div class="demo-accounts__title">
          <span>Contas de demonstração (senha: 123456):</span>
        </div>
        <ul>
          <li><strong>Administrador:</strong> <button type="button" class="link-btn" onclick="fillLogin('roberto.ferreira@senac.br','123456')">roberto.ferreira@senac.br</button></li>
          <li><strong>Professor:</strong> <button type="button" class="link-btn" onclick="fillLogin('carlos.silva@senac.br','123456')">carlos.silva@senac.br</button></li>
          <li><strong>Aluno:</strong> <button type="button" class="link-btn" onclick="fillLogin('joao.almeida@aluno.senac.br','123456')">joao.almeida@aluno.senac.br</button></li>
        </ul>
      </div>

      <!-- Links de ajuda e contato já existentes -->
      <footer class="login-footer">
        <p>
          Ainda não tem conta?
          <a href="/contato" class="link">Fale com a administração</a>
        </p>

        <!-- Acesso à Central de Ajuda -->
        <p>
          Precisa de ajuda?
          <a href="/ajuda" class="link">
            Acesse a Central de Ajuda
          </a>
        </p>
      </footer>

    </section>
  </main>

  <!-- Script original do formulário de login -->
  <script src="/js/login.js" defer></script>
</body>
</html>
