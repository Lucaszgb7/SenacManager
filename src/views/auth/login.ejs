<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../partials/head', { title: 'Entrar', pageCss: 'login.css' }) %>

<body class="login-page">
  <main class="login-container">
    <section class="card login-card">

      <!-- Cabeçalho / Identidade -->
      <header class="login-brand">
        <div class="login-brand__badge">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
          </svg>
        </div>
        <h1 class="login-brand__name">Senac<span>Manager</span></h1>
        <p class="login-brand__tagline">
          Portal Integrado de Gestão Acadêmica e Alocação de Salas
        </p>
      </header>

      <!-- Bloco de erro vindo do backend -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="login-alert" role="alert">
          <%= error %>
        </div>
      <% } %>

      <!-- Formulário de login -->
      <form
        id="login-form"
        class="login-form"
        method="POST"
        action="/auth/login"
        novalidate
      >
        <!-- Campo: e-mail -->
        <div class="input-group">
          <label for="email">E-mail Institucional</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="seu.email@senac.br"
            autocomplete="email"
            required
          />
          <span class="error-message" data-error-for="email"></span>
        </div>

        <!-- Campo: senha (com toggle de visibilidade) -->
        <div class="input-group">
          <label for="password">Senha de Acesso</label>
          <div class="password-wrapper">
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Digite sua senha"
              autocomplete="current-password"
              required
            />
            <button
              type="button"
              class="password-toggle"
              id="toggle-password"
              aria-label="Mostrar senha"
              aria-pressed="false"
            >
              <!-- Ícone: olho aberto -->
              <svg
                id="icon-eye"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <!-- Ícone: olho fechado -->
              <svg
                id="icon-eye-off"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                style="display: none"
              >
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
            </button>
          </div>
          <span class="error-message" data-error-for="password"></span>
        </div>

        <!-- Linha: lembrar-me + esqueci minha senha -->
        <div class="login-form__row">
          <label class="checkbox-group" for="remember" style="margin: 0;">
            <input type="checkbox" id="remember" name="remember" value="1" />
            Lembrar minha sessão
          </label>

          <a href="/auth/forgot-password" class="link">Esqueceu a senha?</a>
        </div>

        <!-- Botão de envio -->
        <button
          type="submit"
          id="submit-btn"
          class="btn btn-primary login-form__submit"
        >
          Acessar o Sistema
        </button>
      </form>

      <!-- Painel de Contas de Teste / Demonstração -->
      <div class="demo-accounts">
        <div class="demo-accounts__title">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          Contas cadastradas para teste:
        </div>
        <ul>
          <li><strong>Professor:</strong> carlos.silva@senac.br (Senha: 123456)</li>
          <li><strong>Administrador:</strong> roberto.ferreira@senac.br (Senha: 123456)</li>
          <li><strong>Aluno:</strong> joao.almeida@aluno.senac.br (Senha: 123456)</li>
        </ul>
      </div>

      <!-- Rodapé do card -->
      <footer class="login-footer">
        <p>
          Precisa de auxílio com seu acesso?
          <a href="/contato" class="link">Suporte Acadêmico</a>
        </p>
      </footer>

    </section>
  </main>

  <script src="/js/login.js" defer></script>
</body>
</html>