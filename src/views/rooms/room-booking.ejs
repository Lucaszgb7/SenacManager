<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../partials/head', { title: 'Reservar sala', pageCss: 'room-booking.css' }) %>
<body>
<%- include('../partials/header', { usuario }) %>
<%- include('../partials/sidebar', { perfil: usuario.perfil }) %>
<main class="app-main"><div class="app-main__inner">
<h1 class="page-title">Reservar sala</h1>

<p class="page-subtitle">Consulte o intervalo e confirme a sala para sua aula.</p>
<form method="get" action="/rooms/booking" class="card booking-form">
<div class="booking-form-row">
<label class="input-group">Data<input type="date" name="data" min="<%= hoje %>" value="<%= filtros.data || '' %>" required></label>
<label class="input-group">Início<input type="time" name="horarioInicio" value="<%= filtros.horarioInicio || '' %>" required></label>
<label class="input-group">Término<input type="time" name="horarioFim" value="<%= filtros.horarioFim || '' %>" required></label>
</div><button class="btn" type="submit">Consultar disponibilidade</button></form>
<form action="/rooms/booking" method="post" data-api-form data-redirect="/bookings/my" class="card">
<div class="form-grid">
<label class="input-group">Sala<select name="salaId" required><option value="">Selecione</option><% salas.forEach(s => { %><option value="<%= s.id %>" <%= s.indisponivel ? 'disabled' : '' %> <%= filtros.salaId === s.id ? 'selected' : '' %>><%= s.nome %> · <%= s.capacidade %> lugares<%= s.indisponivel ? ' (ocupada no intervalo)' : '' %></option><% }) %></select></label>
<label class="input-group">Data<input type="date" name="data" min="<%= hoje %>" value="<%= filtros.data || '' %>" required></label>
<label class="input-group">Início<input type="time" name="horarioInicio" value="<%= filtros.horarioInicio || '' %>" required></label>
<label class="input-group">Término<input type="time" name="horarioFim" value="<%= filtros.horarioFim || '' %>" required></label>
<label class="input-group">Disciplina<input name="disciplina" minlength="2" required></label>
<label class="input-group">Turma<input name="turma" required></label>
</div><p data-feedback role="status" hidden></p><button class="btn btn-primary" type="submit">Confirmar reserva</button>
</form>
</div></main>
<%- include('../partials/footer') %>
</body></html>
