<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../partials/head', { title: 'Salas disponíveis', pageCss: 'available-rooms.css' }) %>
<body>
<%- include('../partials/header', { usuario }) %>
<%- include('../partials/sidebar', { perfil: usuario.perfil }) %>
<main class="app-main"><div class="app-main__inner">
<h1 class="page-title">Salas disponíveis</h1>

<p class="page-subtitle">Ocupação no momento da consulta. Atualize para consultar novamente.</p>
<form class="toolbar" data-filter-form><label class="input-group">Buscar sala<input type="search" name="q"></label>
<label class="input-group">Estado<select name="status"><option value="">Todos</option><option value="disponivel">Disponíveis</option><option value="ocupada">Ocupadas</option><option value="inativa">Inativas</option></select></label></form>
<div class="rooms-grid">
<% salas.forEach(s => { %><article class="room-card" data-filter-item data-search="<%= s.nome.toLowerCase() %>" data-status="<%= s.status %>">
<h2 class="room-card-name"><%= s.nome %></h2><p><%= s.predio %> · <%= s.capacidade %> lugares</p><strong><%= {disponivel:'Disponível',ocupada:'Ocupada',inativa:'Inativa'}[s.status] %></strong>
<% if (s.ocupacaoAtual) { %><p><%= s.ocupacaoAtual.professor %> · <%= s.ocupacaoAtual.disciplina %><br>Livre às <%= s.ocupacaoAtual.horarioFim %></p><% } %>
<% if (usuario.perfil === 'professor' && s.ativa !== false) { %><a class="btn btn-primary" href="/rooms/booking?salaId=<%= s.id %>">Reservar</a><% } %>
</article><% }) %></div><p data-filter-empty hidden>Nenhuma sala encontrada.</p>
</div></main>
<%- include('../partials/footer') %>
</body></html>
