<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../partials/head', { title: 'Painel administrativo', pageCss: 'admin-panel.css' }) %>
<body>
<%- include('../partials/header', { usuario }) %>
<%- include('../partials/sidebar', { perfil: usuario.perfil }) %>
<main class="app-main"><div class="app-main__inner">
<h1 class="page-title">Painel administrativo</h1>

<p class="page-subtitle">Gerencie os registros do sistema.</p>
<div class="tabs" role="tablist"><button class="tab is-active" data-tab="salas" role="tab" aria-selected="true">Salas</button><button class="tab" data-tab="aulas-grade" role="tab" aria-selected="false">Horários</button><button class="tab" data-tab="usuarios" role="tab" aria-selected="false">Usuários</button></div>
<% [['salas',salas],['aulas-grade',aulas],['usuarios',usuarios]].forEach(([kind,rows]) => { %>
<section data-panel="<%= kind %>" <%= kind === 'salas' ? '' : 'hidden' %>>
<p class="toolbar"><a class="btn btn-primary" href="/admin/<%= kind %>/edit">Novo cadastro</a></p>
<div class="table-wrap"><table class="data-table"><thead><tr><th>Nome</th><th>Informações</th><th>Estado</th><th>Ações</th></tr></thead><tbody>
<% rows.forEach(r => { %><tr><td><%= r.nome || r.disciplina %></td><td><%= kind === 'salas' ? r.predio + ' · ' + r.capacidade + ' lugares' : kind === 'usuarios' ? r.email + ' · ' + r.perfil : r.professor.nome + ' · ' + r.sala + ' · ' + r.diaSemana + ' · ' + r.horario + ' · ' + r.semestre %></td><td><%= (kind === 'usuarios' ? r.ativo : r.ativa) === false ? 'Inativo' : 'Ativo' %></td><td><a class="btn-link" href="/admin/<%= kind %>/edit?id=<%= r.id %>">Editar</a> <button class="btn-link btn-link--danger" data-api-action="/admin/<%= kind %>/<%= r.id %>" data-method="DELETE" data-confirm="Excluir este registro?">Excluir</button><p data-feedback role="status" hidden></p></td></tr><% }) %>
</tbody></table></div><% if (!rows.length) { %><p>Nenhum registro cadastrado.</p><% } %></section><% }) %>
</div></main>
<%- include('../partials/footer') %>
</body></html>
