<%- include('../partials/header', { activePage: 'profile' }) %>

<main class="profile-page container">
  <header class="profile-header">
    <h1>Meu Perfil</h1>
    <p class="profile-subtitle">Gerencie suas informações pessoais, senha e foto.</p>
  </header>

  <!-- Feedback global (sucesso/erro vindo do controller) -->
  <% if (message) { %>
    <div class="alert alert-<%= message.type %>" role="alert">
      <%= message.text %>
      <button class="alert-close" aria-label="Fechar">×</button>
    </div>
  <% } %>

  <section class="profile-grid">
    <!-- Foto do usuário -->
    <div class="profile-card profile-avatar-card">
      <h2>Foto de perfil</h2>
      <img
        id="avatar-preview"
        class="profile-avatar"
        src="<%= user && user.avatar ? user.avatar : '/images/default-avatar.png' %>"
        alt="Foto de perfil de <%= user ? user.name : 'usuário' %>"
      />
      <form
        action="/profile/avatar"
        method="POST"
        enctype="multipart/form-data"
        id="avatar-form"
      >
        <label class="btn btn-secondary">
          Escolher imagem
          <input
            type="file"
            name="avatar"
            id="avatar-input"
            accept="image/png, image/jpeg, image/webp"
            hidden
          />
        </label>
        <button type="submit" class="btn btn-primary">Enviar foto</button>
      </form>
      <small class="hint">JPG, PNG ou WEBP · máx. 2 MB</small>
    </div>

    <!-- Dados cadastrais -->
    <div class="profile-card">
      <h2>Dados pessoais</h2>
      <form action="/profile/info" method="POST" class="profile-form" novalidate>
        <div class="form-group">
          <label for="name">Nome completo *</label>
          <input
            type="text"
            id="name"
            name="name"
            value="<%= user ? user.name : '' %>"
            required
            maxlength="120"
          />
        </div>
        <div class="form-group">
          <label for="email">E-mail *</label>
          <input
            type="email"
            id="email"
            name="email"
            value="<%= user ? user.email : '' %>"
            required
            maxlength="120"
          />
        </div>
        <button type="submit" class="btn btn-primary">Salvar dados</button>
      </form>
    </div>

    <!-- Alteração de senha -->
    <div class="profile-card">
      <h2>Alterar senha</h2>
      <form action="/profile/password" method="POST" class="profile-form" id="password-form" novalidate>
        <div class="form-group">
          <label for="currentPassword">Senha atual *</label>
          <div class="input-with-toggle">
            <input type="password" id="currentPassword" name="currentPassword" required />
            <button type="button" class="toggle-password" data-target="currentPassword">👁</button>
          </div>
        </div>

        <div class="form-group">
          <label for="newPassword">Nova senha *</label>
          <div class="input-with-toggle">
            <input
              type="password"
              id="newPassword"
              name="newPassword"
              required
              minlength="8"
              autocomplete="new-password"
            />
            <button type="button" class="toggle-password" data-target="newPassword">👁</button>
          </div>
          <div class="password-strength" aria-live="polite">
            <span class="bar"></span>
            <small class="strength-text">Mín. 8 caracteres, com letras e números.</small>
          </div>
        </div>

        <div class="form-group">
          <label for="confirmPassword">Confirmar nova senha *</label>
          <div class="input-with-toggle">
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              required
              minlength="8"
              autocomplete="new-password"
            />
            <button type="button" class="toggle-password" data-target="confirmPassword">👁</button>
          </div>
          <small id="password-match" class="hint"></small>
        </div>

        <button type="submit" class="btn btn-primary">Alterar senha</button>
      </form>
    </div>
  </section>
</main>

<script src="/js/profile.js" defer></script>
<%- include('../partials/footer') %>