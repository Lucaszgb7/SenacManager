<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../partials/head', { title: 'Meu perfil', pageCss: 'profile.css' }) %>
<body>
<%- include('../partials/header', { usuario }) %>
<%- include('../partials/sidebar', { perfil: usuario.perfil }) %>
<main class="app-main"><div class="app-main__inner">
<h1 class="page-title">Meu perfil</h1>

<section class="card profile-header">
<% if (usuario.fotoUrl) { %><img class="profile-photo" src="<%= usuario.fotoUrl %>" alt="Foto de <%= usuario.nome %>"><% } %>
<div><h2><%= usuario.nome %></h2><p><%= usuario.email %></p><p><%= usuario.perfil %></p></div>
</section>
<section class="card"><h2 class="card__title">Informações pessoais</h2>
<form action="/profile" method="post" data-api-form data-method="PUT" data-redirect="/profile">
<div class="form-grid"><label class="input-group">Nome<input name="nome" value="<%= usuario.nome %>" minlength="3" required></label>
<label class="input-group">E-mail<input name="email" type="email" value="<%= usuario.email %>" required></label>
<label class="input-group">Telefone<input name="telefone" type="tel" value="<%= usuario.telefone || '' %>"></label>
<% if (usuario.perfil === 'professor') { %><label class="input-group">Disciplinas (separadas por vírgula)<input name="disciplinas" data-array value="<%= (usuario.disciplinas || []).join(', ') %>"></label><% } %>
<% if (usuario.perfil === 'aluno') { %><label class="input-group">Curso<input name="curso" value="<%= usuario.curso %>" minlength="2" required></label><label class="input-group">Turma<input name="turma" value="<%= usuario.turma %>" required></label><% } %>
</div><p data-feedback role="status" hidden></p><button type="submit" class="btn btn-primary">Salvar dados</button></form></section>
<section class="card"><h2 class="card__title">Alterar senha</h2>
<form action="/profile/senha" method="post" data-api-form data-method="PUT" data-reset>
<div class="form-grid"><label class="input-group">Senha atual<input type="password" name="senhaAtual" autocomplete="current-password" required></label>
<label class="input-group">Nova senha<input type="password" name="novaSenha" autocomplete="new-password" minlength="8" required></label>
<label class="input-group">Confirmar nova senha<input type="password" name="confirmarSenha" autocomplete="new-password" minlength="8" required></label></div>
<p data-feedback role="status" hidden></p><button class="btn btn-primary" type="submit">Alterar senha</button></form></section>
<section class="card"><h2 class="card__title">Foto de perfil</h2><form action="/profile/foto" method="post" enctype="multipart/form-data" data-api-form data-redirect="/profile">
<label class="input-group">Imagem JPG, PNG ou WebP de até 2 MB<input type="file" name="avatar" accept="image/jpeg,image/png,image/webp" required></label>
<p data-feedback role="status" hidden></p><button class="btn btn-primary" type="submit">Salvar foto</button></form></section>
</div></main>
<%- include('../partials/footer') %>
</body></html>
