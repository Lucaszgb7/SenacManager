<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | SenacManager</title>
  <meta name="description" content="Sistema de gestão acadêmica e reserva de salas do Senac" />
  <meta property="og:title" content="<%= title %> | SenacManager" />
  <meta property="og:description" content="Sistema de gestão acadêmica e reserva de salas do Senac" />

  <!-- Fontes: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <!-- Estilos base do projeto -->
  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/components.css" />

  <!-- Estilos específicos da página (opcional) -->
  <% if (typeof pageCss !== 'undefined' && pageCss) { %>
    <link rel="stylesheet" href="/css/<%= pageCss %>" />
  <% } %>
<link rel="stylesheet" href="/css/dashboard.css">
<link rel="stylesheet" href="/css/functional.css">
<script src="/js/sidebar.js" defer></script>
<script src="/js/app.js" defer></script>
</head>