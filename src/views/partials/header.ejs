<header class="app-header">
  <div class="app-header__left">
    <button
      type="button"
      class="hamburger-btn"
      id="hamburgerBtn"
      aria-label="Abrir menu de navegação"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a href="/dashboard" class="app-header__logo">
      Senac<span>Manager</span>
    </a>

    <div class="app-header__breadcrumb">
      <span class="badge badge--info" style="font-size: 0.7rem; padding: 2px 8px;">Sistema Acadêmico</span>
      <span style="color: var(--color-border); font-size: 0.9rem;">/</span>
      <strong><%= typeof title !== 'undefined' ? title : 'Gestão Escolar' %></strong>
    </div>
  </div>

  <div class="app-header__right">
    <!-- Botão de Notificações com Indicador -->
    <button type="button" class="header-action-btn" aria-label="Notificações do sistema" title="Sem notificações pendentes">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
      </svg>
      <span class="header-action-btn__badge"></span>
    </button>

    <!-- Menu do Usuário com Dropdown -->
    <div class="avatar-menu" id="avatarMenu">
      <button
        type="button"
        class="avatar-menu__trigger"
        id="avatarTrigger"
        aria-haspopup="true"
        aria-expanded="false"
      >
        <% if (usuario && usuario.fotoUrl) { %>
          <img src="<%= usuario.fotoUrl %>" alt="Foto de perfil" class="avatar avatar--sm" style="object-fit: cover;">
        <% } else { %>
          <span class="avatar avatar--sm">
            <%= (usuario && usuario.nome ? usuario.nome : 'Usuário')
                  .split(' ')
                  .filter(Boolean)
                  .slice(0, 2)
                  .map(function(n){ return n[0].toUpperCase(); })
                  .join('') %>
          </span>
        <% } %>
        
        <div class="avatar-menu__info">
          <span class="avatar-menu__name">
            <%= usuario && usuario.nome ? usuario.nome : 'Usuário' %>
          </span>
          <span class="avatar-menu__role">
            <%= usuario && usuario.perfil ? usuario.perfil : 'aluno' %>
          </span>
        </div>

        <svg class="avatar-menu__caret" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="avatar-menu__dropdown" id="avatarDropdown" hidden>
        <div class="avatar-menu__dropdown-header">
          <strong style="display: block; font-size: 0.85rem; color: var(--color-navy);"><%= usuario && usuario.nome ? usuario.nome : 'Usuário' %></strong>
          <span class="avatar-menu__dropdown-email"><%= usuario && usuario.email ? usuario.email : '' %></span>
        </div>

        <a href="/profile" class="avatar-menu__item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span>Meu perfil</span>
        </a>

        <form action="/auth/logout" method="post" style="margin: 0;">
          <button type="submit" class="avatar-menu__item avatar-menu__item--danger">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Sair</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</header>