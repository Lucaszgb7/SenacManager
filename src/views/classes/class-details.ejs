<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../partials/head', { title: 'Detalhes da aula', pageCss: 'class-details.css' }) %>
<body>
<%- include('../partials/header', { usuario }) %>
<%- include('../partials/sidebar', { perfil: usuario.perfil }) %>
<main class="app-main"><div class="app-main__inner">
<h1 class="page-title">Detalhes da aula</h1>

<p><a href="/search" class="back-link">Voltar à pesquisa</a></p><article class="card">
<h2><%= aula.disciplina %></h2><p><%= aula.isNoa ? 'Atividade NOA' : 'Aula regular' %> · <%= aula.ativa === false ? 'Cancelada' : 'Ativa' %></p>
<dl class="details-list"><dt>Professor</dt><dd><%= aula.professor.nome %></dd><dt>Sala</dt><dd><%= aula.sala %> · <%= aula.predio %></dd><dt>Horário</dt><dd><%= aula.diaSemana %> · <%= aula.horario %></dd><dt>Turma</dt><dd><%= aula.turma %></dd><dt>Semestre</dt><dd><%= aula.semestre %></dd></dl><p><%= aula.descricao %></p>
<% if (usuario.perfil === 'administrador' || (usuario.perfil === 'professor' && aula.professorId === usuario.id)) { %>
<div class="toolbar"><a class="btn btn-primary" href="/classes/<%= aula.id %>/edit">Editar</a>
<% if (aula.ativa !== false) { %><button class="btn" data-api-action="/classes/<%= aula.id %>/cancelar" data-confirm="Cancelar esta aula?">Cancelar aula</button><% } %>
<% if (usuario.perfil === 'administrador') { %><button class="btn btn-danger-outline" data-api-action="/admin/aulas-grade/<%= aula.id %>" data-method="DELETE" data-confirm="Excluir esta aula definitivamente?" data-redirect="/search">Excluir</button><% } %></div><% } %>
<p data-feedback role="status" hidden></p></article>
</div></main>
<%- include('../partials/footer') %>
</body></html>
