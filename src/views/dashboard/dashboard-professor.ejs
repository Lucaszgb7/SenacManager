<%- include('../partials/head', { title: 'Dashboard — Professor' }) %>
<link rel="stylesheet" href="/css/dashboard.css" />

<%- include('../partials/header', {
  usuario: { nome: 'Prof. Ana Ribeiro', perfil: 'professor' }
}) %>
<%- include('../partials/sidebar', { perfil: 'professor', paginaAtual: 'dashboard' }) %>

<%
  // ---------- DADOS MOCKADOS ----------
  var usuario = { nome: 'Prof. Ana Ribeiro', perfil: 'professor' };
  var hoje = new Date();
  var dataFormatada = hoje.toLocaleDateString('pt-BR', {
    weekday: 'long', day: '2-digit', month: 'long', year: 'numeric'
  });

  var proximasAulas = [
    { horario: '08:00 — 09:40', disciplina: 'Desenvolvimento Web II', sala: 'Lab 03 — Bloco B' },
    { horario: '10:00 — 11:40', disciplina: 'Banco de Dados',          sala: 'Sala 12 — Bloco A' },
    { horario: '14:00 — 15:40', disciplina: 'Projeto Integrador',      sala: 'Lab 05 — Bloco C' }
  ];

  var salasDisponiveis = [
    { nome: 'Lab 08 — Bloco B', capacidade: 30 },
    { nome: 'Sala 21 — Bloco A', capacidade: 40 },
    { nome: 'Auditório',         capacidade: 120 },
    { nome: 'Sala 05 — Bloco C', capacidade: 25 }
  ];
%>

<main class="app-main">
  <div class="app-main__inner">

    <h1 class="page-title">Olá, <%= usuario.nome %></h1>
    <p class="page-subtitle"><%= dataFormatada %></p>

    <div style="margin-bottom: 24px;">
      <a href="/rooms/booking" class="btn btn-primary">+ Reservar Sala</a>
    </div>

    <div class="card-grid">

      <section class="card">
        <h2 class="card__title">Próximas aulas de hoje</h2>
        <ul class="list-clean">
          <% proximasAulas.forEach(function(a) { %>
            <li class="list-clean__item">
              <strong class="list-clean__time"><%= a.horario %></strong>
              <div>
                <div class="list-clean__primary"><%= a.disciplina %></div>
                <div class="list-clean__secondary"><%= a.sala %></div>
              </div>
            </li>
          <% }); %>
        </ul>
      </section>

      <section class="card">
        <h2 class="card__title">Salas disponíveis agora</h2>
        <ul class="list-clean">
          <% salasDisponiveis.forEach(function(s) { %>
            <li class="list-clean__item">
              <div>
                <div class="list-clean__primary"><%= s.nome %></div>
                <div class="list-clean__secondary">Capacidade: <%= s.capacidade %> lugares</div>
              </div>
            </li>
          <% }); %>
        </ul>
      </section>

    </div>
  </div>
</main>

<%- include('../partials/footer') %>

