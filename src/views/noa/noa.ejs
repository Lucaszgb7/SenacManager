<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../partials/head', { title: 'NOA — Novas Oportunidades de Aprendizagem', pageCss: 'noa.css' }) %>
<body>
<%- include('../partials/header', { usuario }) %>
<%- include('../partials/sidebar', { perfil: usuario.perfil }) %>
<main class="app-main"><div class="app-main__inner">
<h1 class="page-title">NOA — Novas Oportunidades de Aprendizagem</h1>

<p class="page-subtitle">Atividades disponíveis no semestre atual.</p>
<h2>Atividades disponíveis</h2>
<% if (!atividades.length) { %><p>Nenhuma atividade aberta neste semestre.</p><% } %>
<div class="noa-grid"><% atividades.forEach(a => { %><article class="card noa-card"><h3><a href="/classes/details?id=<%= a.id %>"><%= a.disciplina %></a></h3><p><%= a.professor.nome %> · <%= a.sala %></p><p><%= a.diaSemana %> · <%= a.horario %></p><p><%= a.vagasOcupadas %>/<%= a.vagasTotal %> vagas ocupadas</p>
<button class="btn btn-primary" data-api-action="/noa/<%= a.id %>/inscrever" <%= a.inscrito || a.vagasOcupadas >= a.vagasTotal ? 'disabled' : '' %>><%= a.inscrito ? 'Já inscrito' : a.vagasOcupadas >= a.vagasTotal ? 'Esgotado' : 'Inscrever-se' %></button><p data-feedback role="status" hidden></p></article><% }) %></div>
<h2>Minhas inscrições</h2>
<% if (!minhasInscricoes.length) { %><p>Você ainda não possui inscrições.</p><% } %>
<% minhasInscricoes.forEach(a => { %><article class="card"><h3><%= a.disciplina %></h3><p><%= a.semestre %> · <%= a.ativa === false ? 'Atividade cancelada' : a.horario %></p><button class="btn" data-api-action="/noa/<%= a.id %>/cancelar" data-confirm="Cancelar sua inscrição?">Cancelar inscrição</button><p data-feedback role="status" hidden></p></article><% }) %>
</div></main>
<%- include('../partials/footer') %>
</body></html>
