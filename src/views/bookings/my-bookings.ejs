<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../partials/head', { title: 'Minhas reservas', pageCss: 'my-bookings.css' }) %>
<body>
<%- include('../partials/header', { usuario }) %>
<%- include('../partials/sidebar', { perfil: usuario.perfil }) %>
<main class="app-main"><div class="app-main__inner">
<h1 class="page-title">Minhas reservas</h1>

<p class="toolbar"><a href="/rooms/booking" class="btn btn-primary">Nova reserva</a></p>
<div class="tabs" role="tablist"><button type="button" class="tab is-active" data-tab="proximas" role="tab" aria-selected="true">Próximas (<%= reservasFuturas.length %>)</button><button type="button" class="tab" data-tab="historico" role="tab" aria-selected="false">Histórico (<%= reservasPassadas.length %>)</button></div>
<% [['proximas', reservasFuturas], ['historico', reservasPassadas]].forEach(([tab, rows]) => { %>
<section data-panel="<%= tab %>" <%= tab === 'historico' ? 'hidden' : '' %>>
<% if (!rows.length) { %><p>Nenhuma reserva nesta lista.</p><% } %>
<% rows.forEach(r => { %><article class="card booking-card"><h2><%= r.sala %></h2><p><%= r.data %> · <%= r.horario %></p><p><%= r.disciplina %> · <%= r.turma %></p><p><%= r.status === 'confirmada' ? 'Confirmada' : 'Cancelada' %></p>
<% if (tab === 'proximas') { %><button type="button" class="btn btn-danger-outline" data-api-action="/bookings/<%= r.id %>/cancelar" data-confirm="Cancelar esta reserva?">Cancelar reserva</button><% } %><p data-feedback role="status" hidden></p></article><% }) %>
</section><% }) %>
</div></main>
<%- include('../partials/footer') %>
</body></html>
