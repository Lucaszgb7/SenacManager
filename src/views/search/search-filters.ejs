<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../partials/head', { title: 'Pesquisar aulas', pageCss: 'search-filters.css' }) %>
<body>
<%- include('../partials/header', { usuario }) %>
<%- include('../partials/sidebar', { perfil: usuario.perfil }) %>
<main class="app-main"><div class="app-main__inner">
<h1 class="page-title">Pesquisar aulas</h1>

<form action="/search" method="get" class="card toolbar"><label class="input-group">Disciplina, professor, sala, turma, dia ou semestre<input type="search" name="q" value="<%= busca %>"></label><button class="btn btn-primary" type="submit">Pesquisar</button></form>
<p><%= aulas.length %> aula(s) encontrada(s).</p>
<div class="card-grid"><% aulas.forEach(a => { %><a class="card" href="/classes/details?id=<%= a.id %>"><h2><%= a.disciplina %></h2><p><%= a.professor.nome %> · <%= a.sala %></p><p><%= a.diaSemana %> · <%= a.horario %> · <%= a.semestre %></p><p><%= a.ativa === false ? 'Cancelada' : 'Ativa' %></p></a><% }) %></div>
<% if (!aulas.length) { %><p>Nenhuma aula encontrada. Tente outro termo.</p><% } %>
</div></main>
<%- include('../partials/footer') %>
</body></html>
